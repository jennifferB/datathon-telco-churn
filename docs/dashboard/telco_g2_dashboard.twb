              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.038bc7i1dilum915ehqug1qmwu7k].[usr:Calculation_2215030282260498:qk]' />
            </encodings>
            <customized-label>
