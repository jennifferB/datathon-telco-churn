    <worksheet name='Escenarios por segmento'>
      <table>
        <view>
          <datasources>
            <datasource caption='telco_g2' name='federated.038bc7i1dilum915ehqug1qmwu7k' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='escenario' datatype='string' name='[Parameter 2215030278758413]' param-domain-type='list' role='measure' type='nominal' value='&quot;Optimista&quot;'>
              <calculation class='tableau' formula='&quot;Optimista&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.038bc7i1dilum915ehqug1qmwu7k'>
            <column caption='segmento' datatype='string' name='[Calculation_2215030267359232]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [contract_type]=&apos;Month-to-month&apos; AND [internet_service]=&apos;Fiber optic&apos; AND [service_level]=&apos;Basico&apos; THEN &apos;SEG-01&apos;&#13;&#10;ELSEIF [contract_type]=&apos;Month-to-month&apos; AND [tenure_months]&lt;=12 THEN &apos;SEG-02&apos;&#13;&#10;ELSEIF [contract_type]=&apos;Month-to-month&apos; AND [payment_method]=&apos;Electronic check&apos; THEN &apos;SEG-03&apos;&#13;&#10;ELSE &apos;SEG-04&apos; END' />
            </column>
            <column caption='nombre_segmento' datatype='string' name='[Calculation_2215030269353985]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Calculation_2215030267359232]&#13;&#10;WHEN &apos;SEG-01&apos; THEN &apos;Fibra básica mes a mes&apos;&#13;&#10;WHEN &apos;SEG-02&apos; THEN &apos;Nuevos mes a mes (excl. SEG-01)&apos;&#13;&#10;WHEN &apos;SEG-03&apos; THEN &apos;Cheque electrónico mes a mes (excl. SEG-01/02)&apos;&#13;&#10;ELSE &apos;Resto de clientes&apos; END' />
            </column>
            <column caption='churn_porcentaje' datatype='real' default-format='p0.00%' name='[Calculation_2215030274326532]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([churn_flag]) / COUNT([churn_flag])' />
            </column>
            <column caption='factor_escenario' datatype='real' name='[Calculation_2215030280601614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2215030278758413] WHEN &apos;Conservador&apos; THEN 0.5 WHEN &apos;Central&apos; THEN 1.0 WHEN &apos;Optimista&apos; THEN 1.5 END' />
            </column>
            <column caption='reduccion_relativa_central' datatype='real' name='[Calculation_2215030280933391]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Calculation_2215030267359232] WHEN &apos;SEG-01&apos; THEN 0.20 WHEN &apos;SEG-02&apos; THEN 0.15 WHEN &apos;SEG-03&apos; THEN 0.12 ELSE 0.02 END' />
            </column>
            <column caption='reduccion_relativa_escenario' datatype='real' name='[Calculation_2215030281584656]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_2215030280933391] * [Calculation_2215030280601614]' />
            </column>
            <column caption='Churn_escenario_porcentaje' datatype='real' default-format='p0.00%' name='[Calculation_2215030282260498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([churn_flag] * (1 - [Calculation_2215030281584656])) / COUNT([churn_flag])' />
            </column>
            <column caption='Churn Flag' datatype='integer' name='[churn_flag]' role='measure' type='quantitative' />
            <column caption='Contract Type' datatype='string' name='[contract_type]' role='dimension' type='nominal' />
            <column caption='Internet Service' datatype='string' name='[internet_service]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2215030269353985]' derivation='None' name='[none:Calculation_2215030269353985:nk]' pivot='key' type='nominal' />
            <column caption='Payment Method' datatype='string' name='[payment_method]' role='dimension' type='nominal' />
            <column caption='Service Level' datatype='string' name='[service_level]' role='dimension' type='nominal' />
            <column caption='Tenure Months' datatype='integer' name='[tenure_months]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2215030274326532]' derivation='User' name='[usr:Calculation_2215030274326532:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2215030282260498]' derivation='User' name='[usr:Calculation_2215030282260498:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.038bc7i1dilum915ehqug1qmwu7k].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.038bc7i1dilum915ehqug1qmwu7k].[usr:Calculation_2215030282260498:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.038bc7i1dilum915ehqug1qmwu7k].[usr:Calculation_2215030274326532:qk]&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.038bc7i1dilum915ehqug1qmwu7k].[none:Calculation_2215030269353985:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Fibra básica mes a mes&quot;</bucket>
              <bucket>&quot;Nuevos mes a mes (excl. SEG-01)&quot;</bucket>
              <bucket>&quot;Cheque electrónico mes a mes (excl. SEG-01/02)&quot;</bucket>
              <bucket>&quot;Resto de clientes&quot;</bucket>
