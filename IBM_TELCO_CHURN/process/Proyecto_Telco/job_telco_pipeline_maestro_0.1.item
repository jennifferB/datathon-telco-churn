  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="100" posY="220">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="TEXT" name="COMPONENT_NAME" value="tJava" show="false"/>
    <elementParameter field="TEXT" name="VERSION" value="0.101 (ALPHA)" show="false"/>
    <elementParameter field="TEXT" name="FAMILY" value="Custom_Code" show="false"/>
    <elementParameter field="CHECK" name="START" value="true" show="false"/>
    <elementParameter field="CHECK" name="STARTABLE" value="true" show="false"/>
    <elementParameter field="CHECK" name="SUBTREE_START" value="true" show="false"/>
    <elementParameter field="CHECK" name="END_OF_FLOW" value="true" show="false"/>
    <elementParameter field="TEXT" name="HELP" value="org.talend.help.tJava" show="false"/>
    <elementParameter field="DIRECTORY" name="IREPORT_PATH" value="" show="false"/>
    <elementParameter field="DIRECTORY" name="JAVA_LIBRARY_PATH" value="D:\Talent\studio\configuration\lib\java" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="if (!&quot;telco_g2&quot;.equals(context.singlestore_database) || !&quot;3333&quot;.equals(context.singlestore_port)) {&#10;    throw new IllegalArgumentException(&quot;Use la base Cloud telco_g2 y el puerto 3333.&quot;);&#10;}&#10;if (context.singlestore_host == null&#10;        || !context.singlestore_host.matches(&quot;[a-zA-Z0-9.-]+[.]svc[.]singlestore[.]com&quot;)&#10;        || context.singlestore_user == null || context.singlestore_user.trim().isEmpty()&#10;        || context.singlestore_password == null || context.singlestore_password.isEmpty()) {&#10;    throw new IllegalArgumentException(&quot;Complete el host de SingleStore Cloud, usuario y contraseña en Run.&quot;);&#10;}&#10;if (!&quot;validar&quot;.equals(context.modo) &amp;&amp; !&quot;carga_inicial&quot;.equals(context.modo)) {&#10;    throw new IllegalArgumentException(&quot;El modo debe ser validar o carga_inicial.&quot;);&#10;}&#10;if (&quot;carga_inicial&quot;.equals(context.modo)) {&#10;    if (context.snowflake_password == null || context.snowflake_password.isEmpty()) {&#10;        throw new IllegalArgumentException(&quot;Complete snowflake_password antes de la carga inicial.&quot;);&#10;    }&#10;    if (context.csv_filepath == null || context.csv_filepath.trim().isEmpty()&#10;            || !java.nio.file.Files.isReadable(java.nio.file.Paths.get(context.csv_filepath))) {&#10;        throw new IllegalArgumentException(&quot;Indique un CSV que se pueda leer.&quot;);&#10;    }&#10;    if (context.load_source == null || !context.load_source.matches(&quot;[a-zA-Z0-9_-]{1,100}&quot;)) {&#10;        throw new IllegalArgumentException(&quot;Indique un load_source de hasta 100 letras, dígitos, guiones o guiones bajos.&quot;);&#10;    }&#10;&#10;    Class.forName(&quot;com.mysql.cj.jdbc.Driver&quot;);&#10;    java.util.Properties connectionProperties = new java.util.Properties();&#10;    connectionProperties.setProperty(&quot;user&quot;, context.singlestore_user);&#10;    connectionProperties.setProperty(&quot;password&quot;, context.singlestore_password);&#10;    connectionProperties.setProperty(&quot;sslMode&quot;, &quot;REQUIRED&quot;);&#10;    connectionProperties.setProperty(&quot;connectTimeout&quot;, &quot;10000&quot;);&#10;    String url = &quot;jdbc:mysql://&quot; + context.singlestore_host + &quot;:3333/telco_g2&quot;;&#10;    String[] destinations = {&#10;        &quot;raw_telco_g2&quot;, &quot;stg_telco_g2&quot;, &quot;rejects_telco_g2&quot;, &quot;dim_customer_telco_g2&quot;,&#10;        &quot;dim_contract_telco_g2&quot;, &quot;dim_service_telco_g2&quot;, &quot;fact_contracts_telco_g2&quot;&#10;    };&#10;    try (java.sql.Connection conn = java.sql.DriverManager.getConnection(url, connectionProperties);&#10;         java.sql.Statement statement = conn.createStatement()) {&#10;        for (String table : destinations) {&#10;            try (java.sql.ResultSet rows = statement.executeQuery(&quot;SELECT 1 FROM &quot; + table + &quot; LIMIT 1&quot;)) {&#10;                if (rows.next()) {&#10;                    throw new IllegalStateException(&quot;Carga inicial bloqueada porque &quot; + table&#10;                        + &quot; contiene datos. Use el modo validar para revisar la carga actual.&quot;);&#10;                }&#10;            }&#10;        }&#10;        try (java.sql.ResultSet audit = statement.executeQuery(&#10;                &quot;SELECT COUNT(*) FROM information_schema.columns WHERE table_schema = DATABASE() &quot;&#10;                + &quot;AND table_name IN ('dim_customer_telco_g2','dim_contract_telco_g2',&quot;&#10;                + &quot;'dim_service_telco_g2','fact_contracts_telco_g2') &quot;&#10;                + &quot;AND column_name = 'load_ts' AND data_type = 'datetime' AND column_default IS NULL &quot;&#10;                + &quot;AND LOWER(COALESCE(extra, '')) NOT LIKE '%on update%'&quot;)) {&#10;            if (!audit.next() || audit.getInt(1) != 4) {&#10;                throw new IllegalStateException(&quot;El modelo IBM requiere load_ts DATETIME en los cuatro destinos.&quot;);&#10;            }&#10;        }&#10;        try (java.sql.ResultSet origins = statement.executeQuery(&#10;                &quot;SELECT COUNT(*) FROM information_schema.columns WHERE table_schema = DATABASE() &quot;&#10;                + &quot;AND table_name IN ('dim_customer_telco_g2','dim_contract_telco_g2',&quot;&#10;                + &quot;'dim_service_telco_g2','fact_contracts_telco_g2') &quot;&#10;                + &quot;AND column_name = 'load_source' AND data_type = 'varchar' &quot;&#10;                + &quot;AND character_maximum_length &gt;= 100&quot;)) {&#10;            if (!origins.next() || origins.getInt(1) != 4) {&#10;                throw new IllegalStateException(&quot;El modelo requiere load_source VARCHAR(100) en los cuatro destinos.&quot;);&#10;            }&#10;        }&#10;    }&#10;}&#10;System.out.println(&quot;PIPELINE TELCO: modo &quot; + context.modo);"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="Comprobar contexto Cloud y modo"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>
