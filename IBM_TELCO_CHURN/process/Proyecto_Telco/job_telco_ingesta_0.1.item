    <elementParameter field="TEXT" name="LABEL" value="Cargar configuracion local" />
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="// Configuracion privada local: compartida por los jobs, nunca incluida en Git.&#10;String telcoConfigOverride = System.getenv(&quot;TELCO_CONFIG_FILE&quot;);&#10;java.nio.file.Path telcoConfigPath = (telcoConfigOverride != null &amp;&amp; !telcoConfigOverride.isBlank())&#10; ? java.nio.file.Path.of(telcoConfigOverride)&#10; : java.nio.file.Path.of(System.getProperty(&quot;user.home&quot;), &quot;.config&quot;, &quot;geniuslab&quot;, &quot;telco-cloud.properties&quot;);&#10;if (!java.nio.file.Files.isRegularFile(telcoConfigPath))&#10; throw new RuntimeException(&quot;Falta la configuracion local de Telco: &quot; + telcoConfigPath + &quot;. Consulte docs/configuracion_local_telco.md&quot;);&#10;java.util.Properties telcoLocalConfig = new java.util.Properties();&#10;try (java.io.Reader telcoConfigReader = java.nio.file.Files.newBufferedReader(telcoConfigPath, java.nio.charset.StandardCharsets.UTF_8)) {&#10; telcoLocalConfig.load(telcoConfigReader);&#10;}&#10;String telcoEnvPassword = System.getenv(&quot;TELCO_DB_PASSWORD&quot;);&#10;context.singlestore_host = telcoLocalConfig.getProperty(&quot;singlestore_host&quot;, context.singlestore_host).trim();&#10;context.singlestore_port = telcoLocalConfig.getProperty(&quot;singlestore_port&quot;, context.singlestore_port).trim();&#10;context.singlestore_database = telcoLocalConfig.getProperty(&quot;singlestore_database&quot;, context.singlestore_database).trim();&#10;context.singlestore_user = telcoLocalConfig.getProperty(&quot;singlestore_user&quot;, context.singlestore_user).trim();&#10;context.singlestore_password = (telcoEnvPassword != null &amp;&amp; !telcoEnvPassword.isEmpty())&#10; ? telcoEnvPassword : telcoLocalConfig.getProperty(&quot;singlestore_password&quot;, &quot;&quot;);&#10;if (context.singlestore_password.isEmpty())&#10; throw new RuntimeException(&quot;La configuracion local no tiene singlestore_password. No se inicio la conexion.&quot;);&#10;context.csv_filepath = telcoLocalConfig.getProperty(&quot;csv_filepath&quot;, context.csv_filepath);&#10;" />
  </node>
