  <node componentName="tJava" componentVersion="0.101" posX="560" posY="120" offsetLabelX="0" offsetLabelY="0">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1"/>
    <elementParameter field="TEXT" name="COMPONENT_NAME" value="tJava"/>
    <elementParameter field="TEXT" name="LABEL" value="Conciliar y transferir modelo"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="if (!&quot;comparar&quot;.equals(context.modo_snowflake) &amp;&amp; !&quot;cargar&quot;.equals(context.modo_snowflake)) {&#10;    throw new IllegalArgumentException(&quot;modo_snowflake debe ser comparar o cargar.&quot;);&#10;}&#10;if (!&quot;telco_g2&quot;.equals(context.singlestore_database) || !&quot;3333&quot;.equals(context.singlestore_port)&#10;        || context.singlestore_host == null&#10;        || !context.singlestore_host.matches(&quot;[a-zA-Z0-9.-]+[.]svc[.]singlestore[.]com&quot;)) {&#10;    throw new IllegalArgumentException(&quot;Use el origen SingleStore Cloud telco_g2.&quot;);&#10;}&#10;if (context.singlestore_user == null || context.singlestore_user.isBlank()&#10;        || context.singlestore_password == null || context.singlestore_password.isEmpty()&#10;        || context.snowflake_password == null || context.snowflake_password.isEmpty()) {&#10;    throw new IllegalArgumentException(&quot;Complete el usuario de SingleStore y las contraseñas en Run.&quot;);&#10;}&#10;&#10;class ModelTable {&#10;    final String name;&#10;    final String key;&#10;    final String[] columns;&#10;    final long expectedRows;&#10;    String stage;&#10;&#10;    ModelTable(String name, String key, long expectedRows, String columns) {&#10;        this.name = name + &quot;_telco_g2&quot;;&#10;        this.key = key;&#10;        this.expectedRows = expectedRows;&#10;        this.columns = (columns + &quot;,load_ts_anterior,load_source,load_ts&quot;).split(&quot;,&quot;);&#10;    }&#10;&#10;    String quote(String column) {&#10;        return &quot;\&quot;&quot; + column + &quot;\&quot;&quot;;&#10;    }&#10;&#10;    boolean isDate(String column) {&#10;        return &quot;load_ts&quot;.equals(column) || &quot;load_ts_anterior&quot;.equals(column);&#10;    }&#10;&#10;    String target() {&#10;        return &quot;TELCO_G2.ANALYTICS.&quot; + quote(name);&#10;    }&#10;&#10;    String list(String purpose) {&#10;        java.util.List&lt;String&gt; parts = new java.util.ArrayList&lt;&gt;();&#10;        for (String col : columns) {&#10;            String q = quote(col);&#10;            String expr = q;&#10;            if (&quot;source&quot;.equals(purpose)) {&#10;                expr = isDate(col) ? &quot;DATE_FORMAT(`&quot; + col + &quot;`, '%Y-%m-%d %H:%i:%s')&quot; : &quot;`&quot; + col + &quot;`&quot;;&#10;            } else if (isDate(col) &amp;&amp; &quot;compare&quot;.equals(purpose)) {&#10;                expr = &quot;TO_CHAR(&quot; + q + &quot;, 'YYYY-MM-DD HH24:MI:SS') AS &quot; + q;&#10;            } else if (isDate(col) &amp;&amp; &quot;publish&quot;.equals(purpose)) {&#10;                expr = &quot;TO_TIMESTAMP_NTZ(&quot; + q + &quot;, 'YYYY-MM-DD HH24:MI:SS')&quot;;&#10;            }&#10;            parts.add(expr);&#10;        }&#10;        return String.join(&quot;, &quot;, parts);&#10;    }&#10;&#10;    long count(java.sql.Statement stmt, String sql) throws java.sql.SQLException {&#10;        try (java.sql.ResultSet rows = stmt.executeQuery(sql)) {&#10;            rows.next();&#10;            return rows.getLong(1);&#10;        }&#10;    }&#10;&#10;    void insertBatch(java.sql.Connection conn, java.util.List&lt;Object[]&gt; batch) throws java.sql.SQLException {&#10;        String row = &quot;(&quot; + String.join(&quot;,&quot;, java.util.Collections.nCopies(columns.length, &quot;?&quot;)) + &quot;)&quot;;&#10;        String sql = &quot;INSERT INTO &quot; + stage + &quot; (&quot; + list(&quot;stage&quot;) + &quot;) VALUES &quot;&#10;            + String.join(&quot;,&quot;, java.util.Collections.nCopies(batch.size(), row));&#10;        try (java.sql.PreparedStatement insert = conn.prepareStatement(sql)) {&#10;            int index = 1;&#10;            for (Object[] data : batch) {&#10;                for (Object value : data) {&#10;                    if (value == null) {&#10;                        insert.setNull(index++, java.sql.Types.VARCHAR);&#10;                    } else {&#10;                        insert.setObject(index++, value);&#10;                    }&#10;                }&#10;            }&#10;            insert.executeUpdate();&#10;        }&#10;    }&#10;&#10;    void stageFrom(java.sql.Connection source, java.sql.Connection dest, java.sql.Statement sf, String run)&#10;            throws java.sql.SQLException {&#10;        stage = &quot;TELCO_G2.ANALYTICS.TELCO_TRANSFER_&quot; + run + &quot;_&quot; + name.toUpperCase(java.util.Locale.ROOT);&#10;        sf.execute(&quot;CREATE TEMP TABLE &quot; + stage + &quot; AS SELECT &quot; + list(&quot;compare&quot;) + &quot; FROM &quot; + target() + &quot; WHERE 1=0&quot;);&#10;        try (java.sql.Statement stmt = source.createStatement();&#10;             java.sql.ResultSet rows = stmt.executeQuery(&quot;SELECT &quot; + list(&quot;source&quot;) + &quot; FROM telco_g2.&quot; + name)) {&#10;            java.util.List&lt;Object[]&gt; batch = new java.util.ArrayList&lt;&gt;();&#10;            while (rows.next()) {&#10;                Object[] data = new Object[columns.length];&#10;                for (int i = 0; i &lt; data.length; i++) {&#10;                    data[i] = rows.getObject(i + 1);&#10;                }&#10;                batch.add(data);&#10;                if (batch.size() == 150) {&#10;                    insertBatch(dest, batch);&#10;                    batch.clear();&#10;                }&#10;            }&#10;            if (!batch.isEmpty()) {&#10;                insertBatch(dest, batch);&#10;            }&#10;        }&#10;        String valid = &quot;SELECT COUNT(DISTINCT &quot; + quote(key) + &quot;) FROM &quot; + stage&#10;            + &quot; WHERE \&quot;load_ts\&quot; IS NOT NULL AND NULLIF(TRIM(\&quot;load_source\&quot;), '') IS NOT NULL&quot;;&#10;        if (count(sf, &quot;SELECT COUNT(*) FROM &quot; + stage) != expectedRows || count(sf, valid) != expectedRows) {&#10;            throw new IllegalStateException(&quot;La copia de &quot; + name + &quot; no cumple el conteo, las claves o la auditoría.&quot;);&#10;        }&#10;    }&#10;&#10;    boolean sameAsTarget(java.sql.Statement sf) throws java.sql.SQLException {&#10;        long actual = count(sf, &quot;SELECT COUNT(*) FROM &quot; + target());&#10;        long missing = count(sf, &quot;SELECT COUNT(*) FROM (SELECT &quot; + list(&quot;stage&quot;) + &quot; FROM &quot; + stage&#10;            + &quot; EXCEPT SELECT &quot; + list(&quot;compare&quot;) + &quot; FROM &quot; + target() + &quot;) diferencia&quot;);&#10;        long extra = count(sf, &quot;SELECT COUNT(*) FROM (SELECT &quot; + list(&quot;compare&quot;) + &quot; FROM &quot; + target()&#10;            + &quot; EXCEPT SELECT &quot; + list(&quot;stage&quot;) + &quot; FROM &quot; + stage + &quot;) diferencia&quot;);&#10;        System.out.printf(&quot;%s: origen=%d destino=%d diferencias_origen=%d diferencias_destino=%d%n&quot;,&#10;            name, expectedRows, actual, missing, extra);&#10;        return actual == expectedRows &amp;&amp; missing == 0 &amp;&amp; extra == 0;&#10;    }&#10;}&#10;&#10;ModelTable customers = new ModelTable(&quot;dim_customer&quot;,&quot;customer_key&quot;,7043,&#10;    &quot;customer_key,customer_id,gender,senior_citizen,partner,dependents&quot;);&#10;ModelTable contracts = new ModelTable(&quot;dim_contract&quot;,&quot;contract_key&quot;,24,&#10;    &quot;contract_key,contract_type,paperless_billing,payment_method&quot;);&#10;ModelTable services = new ModelTable(&quot;dim_service&quot;,&quot;service_key&quot;,322,&#10;    &quot;service_key,phone_service,multiple_lines,internet_service,online_security,online_backup,device_protection,tech_support,streaming_tv,streaming_movies,service_level&quot;);&#10;ModelTable facts = new ModelTable(&quot;fact_contracts&quot;,&quot;customer_key&quot;,7043,&#10;    &quot;customer_key,contract_key,service_key,tenure_months,tenure_group,monthly_charges,total_charges,churn_flag,total_charges_imputed,imputation_reason,source_load_id&quot;);&#10;ModelTable[] model = {customers, contracts, services, facts};&#10;&#10;Class.forName(&quot;com.mysql.cj.jdbc.Driver&quot;);&#10;Class.forName(&quot;net.snowflake.client.jdbc.SnowflakeDriver&quot;);&#10;java.util.Properties mysql = new java.util.Properties();&#10;mysql.setProperty(&quot;user&quot;, context.singlestore_user);&#10;mysql.setProperty(&quot;password&quot;, context.singlestore_password);&#10;mysql.setProperty(&quot;sslMode&quot;, &quot;REQUIRED&quot;);&#10;mysql.setProperty(&quot;connectTimeout&quot;, &quot;10000&quot;);&#10;java.util.Properties snowflake = new java.util.Properties();&#10;snowflake.setProperty(&quot;user&quot;, &quot;ENGINEER_TELCO&quot;);&#10;snowflake.setProperty(&quot;password&quot;, context.snowflake_password);&#10;snowflake.setProperty(&quot;role&quot;, &quot;TELCO_WRITER&quot;);&#10;snowflake.setProperty(&quot;warehouse&quot;, &quot;COMPUTE_WH&quot;);&#10;snowflake.setProperty(&quot;db&quot;, &quot;TELCO_G2&quot;);&#10;snowflake.setProperty(&quot;schema&quot;, &quot;ANALYTICS&quot;);&#10;snowflake.setProperty(&quot;loginTimeout&quot;, &quot;15&quot;);&#10;snowflake.setProperty(&quot;JDBC_QUERY_RESULT_FORMAT&quot;, &quot;JSON&quot;);&#10;String mysqlUrl = &quot;jdbc:mysql://&quot; + context.singlestore_host + &quot;:3333/telco_g2&quot;;&#10;String sfUrl = &quot;jdbc:snowflake://xbbiurh-el04715.snowflakecomputing.com/&quot;;&#10;String run = java.util.UUID.randomUUID().toString().replace(&quot;-&quot;, &quot;&quot;).toUpperCase(java.util.Locale.ROOT);&#10;try (java.sql.Connection source = java.sql.DriverManager.getConnection(mysqlUrl, mysql);&#10;     java.sql.Connection dest = java.sql.DriverManager.getConnection(sfUrl, snowflake);&#10;     java.sql.Statement sf = dest.createStatement()) {&#10;    for (ModelTable table : model) {&#10;        table.stageFrom(source, dest, sf, run);&#10;    }&#10;    String controls = &quot;SELECT COUNT(CASE WHEN f.\&quot;churn_flag\&quot; = 1 THEN 1 END), &quot;&#10;        + &quot;SUM(f.\&quot;total_charges_imputed\&quot;), COUNT(CASE WHEN c.\&quot;customer_key\&quot; IS NULL &quot;&#10;        + &quot;OR ct.\&quot;contract_key\&quot; IS NULL OR sv.\&quot;service_key\&quot; IS NULL THEN 1 END) &quot;&#10;        + &quot;FROM &quot; + facts.stage + &quot; f LEFT JOIN &quot; + customers.stage + &quot; c ON c.\&quot;customer_key\&quot;=f.\&quot;customer_key\&quot; &quot;&#10;        + &quot;LEFT JOIN &quot; + contracts.stage + &quot; ct ON ct.\&quot;contract_key\&quot;=f.\&quot;contract_key\&quot; &quot;&#10;        + &quot;LEFT JOIN &quot; + services.stage + &quot; sv ON sv.\&quot;service_key\&quot;=f.\&quot;service_key\&quot;&quot;;&#10;    try (java.sql.ResultSet result = sf.executeQuery(controls)) {&#10;        if (!result.next() || result.getLong(1) != 1869 || result.getLong(2) != 11 || result.getLong(3) != 0) {&#10;            throw new IllegalStateException(&quot;La copia del modelo no reconcilia churn, imputaciones o relaciones.&quot;);&#10;        }&#10;    }&#10;&#10;    boolean same = true;&#10;    for (ModelTable table : model) {&#10;        same = table.sameAsTarget(sf) &amp;&amp; same;&#10;    }&#10;    if (&quot;comparar&quot;.equals(context.modo_snowflake)) {&#10;        if (!same) {&#10;            throw new IllegalStateException(&quot;Hay diferencias. Las cuatro tablas compartidas siguen intactas.&quot;);&#10;        }&#10;        System.out.println(&quot;SNOWFLAKE CONCILIADO: 7043 hechos, 1869 churn, 11 imputaciones, 0 huérfanos.&quot;);&#10;    } else if (same) {&#10;        System.out.println(&quot;SNOWFLAKE SIN CAMBIOS: el destino ya coincide con SingleStore.&quot;);&#10;    } else {&#10;        dest.setAutoCommit(false);&#10;        try {&#10;            for (int i = model.length - 1; i &gt;= 0; i--) {&#10;                sf.executeUpdate(&quot;DELETE FROM &quot; + model[i].target());&#10;            }&#10;            for (ModelTable table : model) {&#10;                sf.executeUpdate(&quot;INSERT INTO &quot; + table.target() + &quot; (&quot; + table.list(&quot;stage&quot;)&#10;                    + &quot;) SELECT &quot; + table.list(&quot;publish&quot;) + &quot; FROM &quot; + table.stage);&#10;            }&#10;            for (ModelTable table : model) {&#10;                if (!table.sameAsTarget(sf)) {&#10;                    throw new IllegalStateException(&quot;La carga de &quot; + table.name + &quot; no concilia.&quot;);&#10;                }&#10;            }&#10;            dest.commit();&#10;        } catch (Exception failure) {&#10;            try {&#10;                dest.rollback();&#10;            } catch (java.sql.SQLException rollbackFailure) {&#10;                failure.addSuppressed(rollbackFailure);&#10;            }&#10;            throw failure;&#10;        }&#10;        System.out.println(&quot;SNOWFLAKE CARGADO: 7043 hechos, 1869 churn, 11 imputaciones, 0 huérfanos.&quot;);&#10;    }&#10;}"/>
