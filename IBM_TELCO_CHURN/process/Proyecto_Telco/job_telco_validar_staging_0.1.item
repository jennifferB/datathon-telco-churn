  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="420" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" />
    <elementParameter field="TEXT" name="COMPONENT_NAME" value="tJava" />
    <elementParameter field="TEXT" name="LABEL" value="Validacion solo lectura" />
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="if (!&quot;telco_g2&quot;.equals(context.singlestore_database) || !&quot;3333&quot;.equals(context.singlestore_port))&#10; throw new RuntimeException(&quot;Seleccione el contexto Cloud de telco_g2, puerto 3333.&quot;);&#10;if (context.singlestore_password == null || context.singlestore_password.isEmpty())&#10; throw new RuntimeException(&quot;Ingrese la contraseña al ejecutar, sin guardarla en Git.&quot;);&#10;Class.forName(&quot;com.mysql.cj.jdbc.Driver&quot;);&#10;java.util.Properties telcoProps = new java.util.Properties();&#10;telcoProps.setProperty(&quot;user&quot;, context.singlestore_user);&#10;telcoProps.setProperty(&quot;password&quot;, context.singlestore_password);&#10;telcoProps.setProperty(&quot;sslMode&quot;, &quot;REQUIRED&quot;);&#10;telcoProps.setProperty(&quot;connectTimeout&quot;, &quot;10000&quot;);&#10;String telcoUrl = &quot;jdbc:mysql://&quot; + context.singlestore_host.trim() + &quot;:&quot; + context.singlestore_port + &quot;/&quot; + context.singlestore_database;&#10;&#10;try (java.sql.Connection cx = java.sql.DriverManager.getConnection(telcoUrl, telcoProps); java.sql.Statement st = cx.createStatement(); java.sql.ResultSet rs = st.executeQuery(&quot;SELECT\n (SELECT COUNT(*) FROM raw_telco_g2) AS raw_filas,\n (SELECT COUNT(DISTINCT customerID) FROM raw_telco_g2) AS raw_ids,\n (SELECT COUNT(*) FROM raw_telco_g2 WHERE TotalCharges IS NULL) AS raw_nulos,\n (SELECT COUNT(*) FROM raw_telco_g2 WHERE TotalCharges IS NOT NULL AND TRIM(TotalCharges) = '') AS raw_blancos,\n (SELECT COUNT(*) FROM stg_telco_g2) AS stg_filas,\n (SELECT COUNT(DISTINCT customerID) FROM stg_telco_g2) AS stg_ids,\n (SELECT COUNT(*) FROM rejects_telco_g2) AS rechazos,\n (SELECT COUNT(*) FROM stg_telco_g2 WHERE total_charges_imputed = 1) AS imputaciones,\n (SELECT COUNT(*) FROM stg_telco_g2 WHERE total_charges_imputed = 1 AND tenure = 0 AND TotalCharges = 0 AND TRIM(total_charges_raw) = '' AND imputation_reason = 'BLANK_WITH_ZERO_TENURE') AS imputaciones_correctas,\n (SELECT COUNT(*) FROM raw_telco_g2 r LEFT JOIN stg_telco_g2 s ON r.customerID = s.customerID WHERE s.customerID IS NULL) AS ids_sin_staging,\n (SELECT COUNT(*) FROM stg_telco_g2 s LEFT JOIN raw_telco_g2 r ON r.customerID = s.customerID WHERE r.customerID IS NULL) AS ids_sin_raw,\n (SELECT COUNT(*) FROM stg_telco_g2 s JOIN raw_telco_g2 r ON r.customerID = s.customerID WHERE NOT (s.monthly_charges_raw &lt;=&gt; r.MonthlyCharges) OR NOT (s.total_charges_raw &lt;=&gt; r.TotalCharges)) AS originales_alterados,\n (SELECT COUNT(*) FROM stg_telco_g2 WHERE MonthlyCharges IS NULL OR TotalCharges IS NULL OR MonthlyCharges NOT BETWEEN 18 AND 120 OR TotalCharges &lt; 0) AS importes_invalidos\n ,\n (SELECT COUNT(*) FROM stg_telco_g2 s WHERE\n NOT (s.MonthlyCharges &lt;=&gt; CASE WHEN TRIM(s.monthly_charges_raw) REGEXP '^[0-9]{1,3}([.][0-9]{1,2})?$' THEN CAST(TRIM(s.monthly_charges_raw) AS DECIMAL(8,2)) ELSE NULL END)\n OR NOT (s.TotalCharges &lt;=&gt; CASE WHEN TRIM(s.total_charges_raw) = '' AND s.tenure = 0 THEN CAST(0 AS DECIMAL(10,2)) WHEN TRIM(s.total_charges_raw) REGEXP '^[0-9]{1,8}([.][0-9]{1,2})?$' THEN CAST(TRIM(s.total_charges_raw) AS DECIMAL(10,2)) ELSE NULL END)\n OR s.total_charges_imputed &lt;&gt; CASE WHEN TRIM(s.total_charges_raw) = '' AND s.tenure = 0 THEN 1 ELSE 0 END\n ) AS valores_transformados_incorrectos\n, (SELECT COUNT(*) FROM stg_telco_g2 s JOIN raw_telco_g2 r ON s.customerID = r.customerID WHERE NOT (s.`gender` &lt;=&gt; r.`gender`) OR NOT (s.`SeniorCitizen` &lt;=&gt; r.`SeniorCitizen`) OR NOT (s.`Partner` &lt;=&gt; r.`Partner`) OR NOT (s.`Dependents` &lt;=&gt; r.`Dependents`) OR NOT (s.`tenure` &lt;=&gt; r.`tenure`) OR NOT (s.`PhoneService` &lt;=&gt; r.`PhoneService`) OR NOT (s.`MultipleLines` &lt;=&gt; r.`MultipleLines`) OR NOT (s.`InternetService` &lt;=&gt; r.`InternetService`) OR NOT (s.`OnlineSecurity` &lt;=&gt; r.`OnlineSecurity`) OR NOT (s.`OnlineBackup` &lt;=&gt; r.`OnlineBackup`) OR NOT (s.`DeviceProtection` &lt;=&gt; r.`DeviceProtection`) OR NOT (s.`TechSupport` &lt;=&gt; r.`TechSupport`) OR NOT (s.`StreamingTV` &lt;=&gt; r.`StreamingTV`) OR NOT (s.`StreamingMovies` &lt;=&gt; r.`StreamingMovies`) OR NOT (s.`Contract` &lt;=&gt; r.`Contract`) OR NOT (s.`PaperlessBilling` &lt;=&gt; r.`PaperlessBilling`) OR NOT (s.`PaymentMethod` &lt;=&gt; r.`PaymentMethod`) OR NOT (s.`Churn` &lt;=&gt; r.`Churn`) OR NOT (s.`fecha_carga` &lt;=&gt; r.`fecha_carga`)) AS atributos_originales_alterados\n&quot;)) {&#10; rs.next();&#10; int errores = 0;&#10; long raw_filas = rs.getLong(&quot;raw_filas&quot;); System.out.println(&quot;raw_filas=&quot; + raw_filas + &quot; (esperado 7043)&quot;); if (raw_filas != 7043L) errores++;&#10; long raw_ids = rs.getLong(&quot;raw_ids&quot;); System.out.println(&quot;raw_ids=&quot; + raw_ids + &quot; (esperado 7043)&quot;); if (raw_ids != 7043L) errores++;&#10; long raw_nulos = rs.getLong(&quot;raw_nulos&quot;); System.out.println(&quot;raw_nulos=&quot; + raw_nulos + &quot; (esperado 0)&quot;); if (raw_nulos != 0L) errores++;&#10; long raw_blancos = rs.getLong(&quot;raw_blancos&quot;); System.out.println(&quot;raw_blancos=&quot; + raw_blancos + &quot; (esperado 11)&quot;); if (raw_blancos != 11L) errores++;&#10; long stg_filas = rs.getLong(&quot;stg_filas&quot;); System.out.println(&quot;stg_filas=&quot; + stg_filas + &quot; (esperado 7043)&quot;); if (stg_filas != 7043L) errores++;&#10; long stg_ids = rs.getLong(&quot;stg_ids&quot;); System.out.println(&quot;stg_ids=&quot; + stg_ids + &quot; (esperado 7043)&quot;); if (stg_ids != 7043L) errores++;&#10; long rechazos = rs.getLong(&quot;rechazos&quot;); System.out.println(&quot;rechazos=&quot; + rechazos + &quot; (esperado 0)&quot;); if (rechazos != 0L) errores++;&#10; long imputaciones = rs.getLong(&quot;imputaciones&quot;); System.out.println(&quot;imputaciones=&quot; + imputaciones + &quot; (esperado 11)&quot;); if (imputaciones != 11L) errores++;&#10; long imputaciones_correctas = rs.getLong(&quot;imputaciones_correctas&quot;); System.out.println(&quot;imputaciones_correctas=&quot; + imputaciones_correctas + &quot; (esperado 11)&quot;); if (imputaciones_correctas != 11L) errores++;&#10; long ids_sin_staging = rs.getLong(&quot;ids_sin_staging&quot;); System.out.println(&quot;ids_sin_staging=&quot; + ids_sin_staging + &quot; (esperado 0)&quot;); if (ids_sin_staging != 0L) errores++;&#10; long ids_sin_raw = rs.getLong(&quot;ids_sin_raw&quot;); System.out.println(&quot;ids_sin_raw=&quot; + ids_sin_raw + &quot; (esperado 0)&quot;); if (ids_sin_raw != 0L) errores++;&#10; long originales_alterados = rs.getLong(&quot;originales_alterados&quot;); System.out.println(&quot;originales_alterados=&quot; + originales_alterados + &quot; (esperado 0)&quot;); if (originales_alterados != 0L) errores++;&#10; long importes_invalidos = rs.getLong(&quot;importes_invalidos&quot;); System.out.println(&quot;importes_invalidos=&quot; + importes_invalidos + &quot; (esperado 0)&quot;); if (importes_invalidos != 0L) errores++;&#10; long valores_transformados_incorrectos = rs.getLong(&quot;valores_transformados_incorrectos&quot;); System.out.println(&quot;valores_transformados_incorrectos=&quot; + valores_transformados_incorrectos + &quot; (esperado 0)&quot;); if (valores_transformados_incorrectos != 0L) errores++;&#10; long atributos_originales_alterados = rs.getLong(&quot;atributos_originales_alterados&quot;); System.out.println(&quot;atributos_originales_alterados=&quot; + atributos_originales_alterados + &quot; (esperado 0)&quot;); if (atributos_originales_alterados != 0L) errores++;&#10; if (errores != 0) throw new RuntimeException(&quot;Validacion staging fallida: &quot; + errores + &quot; controles. Revisar los conteos; no se modifico raw.&quot;);&#10; System.out.println(&quot;STAGING VALIDADO: 7043 clientes, 11 imputaciones, raw intacto respecto a los controles definidos.&quot;);&#10;}&#10;" />
  </node>
  <connection connectorName="SUBJOB_OK" label="OnSubjobOk_1" lineStyle="1" metaname="OnSubjobOk_1" offsetLabelX="0" offsetLabelY="0" source="tMysqlInput_1" target="tJava_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="OnSubjobOk_1" />
  </connection>
  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="40" posY="20">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_90" />
    <elementParameter field="TEXT" name="COMPONENT_NAME" value="tJava" />
    <elementParameter field="TEXT" name="LABEL" value="Cargar configuracion local" />
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="// Configuracion privada local: compartida por los jobs, nunca incluida en Git.&#10;String telcoConfigOverride = System.getenv(&quot;TELCO_CONFIG_FILE&quot;);&#10;java.nio.file.Path telcoConfigPath = (telcoConfigOverride != null &amp;&amp; !telcoConfigOverride.isBlank())&#10; ? java.nio.file.Path.of(telcoConfigOverride)&#10; : java.nio.file.Path.of(System.getProperty(&quot;user.home&quot;), &quot;.config&quot;, &quot;geniuslab&quot;, &quot;telco-cloud.properties&quot;);&#10;if (!java.nio.file.Files.isRegularFile(telcoConfigPath))&#10; throw new RuntimeException(&quot;Falta la configuracion local de Telco: &quot; + telcoConfigPath + &quot;. Consulte docs/configuracion_local_telco.md&quot;);&#10;java.util.Properties telcoLocalConfig = new java.util.Properties();&#10;try (java.io.Reader telcoConfigReader = java.nio.file.Files.newBufferedReader(telcoConfigPath, java.nio.charset.StandardCharsets.UTF_8)) {&#10; telcoLocalConfig.load(telcoConfigReader);&#10;}&#10;String telcoEnvPassword = System.getenv(&quot;TELCO_DB_PASSWORD&quot;);&#10;context.singlestore_host = telcoLocalConfig.getProperty(&quot;singlestore_host&quot;, context.singlestore_host).trim();&#10;context.singlestore_port = telcoLocalConfig.getProperty(&quot;singlestore_port&quot;, context.singlestore_port).trim();&#10;context.singlestore_database = telcoLocalConfig.getProperty(&quot;singlestore_database&quot;, context.singlestore_database).trim();&#10;context.singlestore_user = telcoLocalConfig.getProperty(&quot;singlestore_user&quot;, context.singlestore_user).trim();&#10;context.singlestore_password = (telcoEnvPassword != null &amp;&amp; !telcoEnvPassword.isEmpty())&#10; ? telcoEnvPassword : telcoLocalConfig.getProperty(&quot;singlestore_password&quot;, &quot;&quot;);&#10;if (context.singlestore_password.isEmpty())&#10; throw new RuntimeException(&quot;La configuracion local no tiene singlestore_password. No se inicio la conexion.&quot;);&#10;" />
  </node>
  <connection connectorName="SUBJOB_OK" label="OnSubjobOk_ConfigLocal" lineStyle="1" metaname="OnSubjobOk_ConfigLocal" offsetLabelX="0" offsetLabelY="0" source="tJava_90" target="tMysqlInput_1">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="OnSubjobOk_ConfigLocal" />
  </connection>
</talendfile:ProcessType>