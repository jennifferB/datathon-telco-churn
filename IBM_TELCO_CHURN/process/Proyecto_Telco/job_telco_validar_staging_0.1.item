  <node componentName="tMysqlInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="120" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMysqlInput_1" />
    <elementParameter field="TEXT" name="COMPONENT_NAME" value="tMysqlInput" />
    <elementParameter field="TEXT" name="LABEL" value="Probar conexion Cloud" />
    <elementParameter field="TEXT" name="DB_VERSION" value="MYSQL_8" />
    <elementParameter field="TEXT" name="USE_EXISTING_CONNECTION" value="false" />
    <elementParameter field="TEXT" name="HOST" value="context.singlestore_host" />
    <elementParameter field="TEXT" name="PORT" value="context.singlestore_port" />
    <elementParameter field="TEXT" name="DBNAME" value="context.singlestore_database" />
    <elementParameter field="TEXT" name="USER" value="context.singlestore_user" />
    <elementParameter field="PASSWORD" name="PASS" value="context.singlestore_password" />
    <elementParameter field="TEXT" name="PROPERTIES" value="&quot;noDatetimeStringSync=true&amp;sslMode=REQUIRED&amp;connectTimeout=10000&quot;" />
    <elementParameter field="TEXT" name="MAPPING" value="mysql_id" />
    <elementParameter field="TEXT" name="SCHEMA:SCHEMA_TYPE" value="BUILT_IN" />
    <elementParameter field="TEXT" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN" />
    <elementParameter field="TEXT" name="TABLE" value="&quot;raw_telco_g2&quot;" />
    <elementParameter field="TEXT" name="QUERY" value="&quot;SELECT 1 AS conexion_ok&quot;" />
    <elementParameter field="TEXT" name="TRIM_ALL_COLUMN" value="false" />
    <elementParameter field="TEXT" name="ENABLE_STREAM" value="false" />
    <metadata connector="FLOW" name="tMysqlInput_1" label="out">
