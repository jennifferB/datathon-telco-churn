    <elementParameter field="DIRECTORY" name="IREPORT_PATH" value="" show="false"/>
    <elementParameter field="DIRECTORY" name="JAVA_LIBRARY_PATH" value="D:\Talent\studio\configuration\lib\java" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="if (!((&quot;telco_g2&quot;.equals(context.singlestore_database) &amp;&amp; &quot;3333&quot;.equals(context.singlestore_port)) || (&quot;DSADEV&quot;.equals(context.singlestore_database) &amp;&amp; &quot;3306&quot;.equals(context.singlestore_port) &amp;&amp; &quot;209.50.245.36&quot;.equals(context.singlestore_host))))&#10; throw new RuntimeException(&quot;Seleccione Cloud (telco_g2:3333) o PRUEBAS (DSADEV:3306 en el servidor de pruebas).&quot;);&#10;if (context.singlestore_password == null || context.singlestore_password.isEmpty())&#10; throw new RuntimeException(&quot;Ingrese la contraseña al ejecutar, sin guardarla en Git.&quot;);&#10;Class.forName(&quot;com.mysql.cj.jdbc.Driver&quot;);&#10;java.util.Properties telcoProps = new java.util.Properties();&#10;telcoProps.setProperty(&quot;user&quot;, context.singlestore_user);&#10;telcoProps.setProperty(&quot;password&quot;, context.singlestore_password);&#10;telcoProps.setProperty(&quot;sslMode&quot;, ((&quot;DSADEV&quot;.equals(context.singlestore_database) &amp;&amp; &quot;3306&quot;.equals(context.singlestore_port) &amp;&amp; &quot;209.50.245.36&quot;.equals(context.singlestore_host)) ? &quot;PREFERRED&quot; : &quot;REQUIRED&quot;));&#10;telcoProps.setProperty(&quot;connectTimeout&quot;, &quot;10000&quot;);&#10;String telcoUrl = &quot;jdbc:mysql://&quot; + context.singlestore_host.trim() + &quot;:&quot; + context.singlestore_port + &quot;/&quot; + context.singlestore_database;&#10;&#10;try (java.sql.Connection cx = java.sql.DriverManager.getConnection(telcoUrl, telcoProps); java.sql.Statement st = cx.createStatement(); java.sql.ResultSet rs = st.executeQuery(&quot;SELECT\n (SELECT COUNT(*) FROM raw_telco_g2) AS raw_filas,\n (SELECT COUNT(DISTINCT customerID) FROM raw_telco_g2) AS raw_ids,\n (SELECT COUNT(*) FROM raw_telco_g2 WHERE TotalCharges IS NULL) AS raw_nulos,\n (SELECT COUNT(*) FROM raw_telco_g2 WHERE TotalCharges IS NOT NULL AND TRIM(TotalCharges) = '') AS raw_blancos,\n (SELECT COUNT(*) FROM stg_telco_g2) AS stg_filas,\n (SELECT COUNT(DISTINCT customerID) FROM stg_telco_g2) AS stg_ids,\n (SELECT COUNT(*) FROM rejects_telco_g2) AS rechazos,\n (SELECT COUNT(*) FROM stg_telco_g2 WHERE total_charges_imputed = 1) AS imputaciones,\n (SELECT COUNT(*) FROM stg_telco_g2 WHERE total_charges_imputed = 1 AND tenure = 0 AND TotalCharges = 0 AND TRIM(total_charges_raw) = '' AND imputation_reason = 'BLANK_WITH_ZERO_TENURE') AS imputaciones_correctas,\n (SELECT COUNT(*) FROM raw_telco_g2 r LEFT JOIN stg_telco_g2 s ON r.customerID = s.customerID WHERE s.customerID IS NULL) AS ids_sin_staging,\n (SELECT COUNT(*) FROM stg_telco_g2 s LEFT JOIN raw_telco_g2 r ON r.customerID = s.customerID WHERE r.customerID IS NULL) AS ids_sin_raw,\n (SELECT COUNT(*) FROM stg_telco_g2 s JOIN raw_telco_g2 r ON r.customerID = s.customerID WHERE NOT (s.monthly_charges_raw &lt;=&gt; r.MonthlyCharges) OR NOT (s.total_charges_raw &lt;=&gt; r.TotalCharges)) AS originales_alterados,\n (SELECT COUNT(*) FROM stg_telco_g2 WHERE MonthlyCharges IS NULL OR TotalCharges IS NULL OR MonthlyCharges NOT BETWEEN 18 AND 120 OR TotalCharges &lt; 0) AS importes_invalidos\n ,\n (SELECT COUNT(*) FROM stg_telco_g2 s WHERE\n NOT (s.MonthlyCharges &lt;=&gt; CASE WHEN TRIM(s.monthly_charges_raw) REGEXP '^[0-9]{1,3}([.][0-9]{1,2})?$' THEN CAST(TRIM(s.monthly_charges_raw) AS DECIMAL(8,2)) ELSE NULL END)\n OR NOT (s.TotalCharges &lt;=&gt; CASE WHEN TRIM(s.total_charges_raw) = '' AND s.tenure = 0 THEN CAST(0 AS DECIMAL(10,2)) WHEN TRIM(s.total_charges_raw) REGEXP '^[0-9]{1,8}([.][0-9]{1,2})?$' THEN CAST(TRIM(s.total_charges_raw) AS DECIMAL(10,2)) ELSE NULL END)\n OR s.total_charges_imputed &lt;&gt; CASE WHEN TRIM(s.total_charges_raw) = '' AND s.tenure = 0 THEN 1 ELSE 0 END\n ) AS valores_transformados_incorrectos\n, (SELECT COUNT(*) FROM stg_telco_g2 s JOIN raw_telco_g2 r ON s.customerID = r.customerID WHERE NOT (s.`gender` &lt;=&gt; r.`gender`) OR NOT (s.`SeniorCitizen` &lt;=&gt; r.`SeniorCitizen`) OR NOT (s.`Partner` &lt;=&gt; r.`Partner`) OR NOT (s.`Dependents` &lt;=&gt; r.`Dependents`) OR NOT (s.`tenure` &lt;=&gt; r.`tenure`) OR NOT (s.`PhoneService` &lt;=&gt; r.`PhoneService`) OR NOT (s.`MultipleLines` &lt;=&gt; r.`MultipleLines`) OR NOT (s.`InternetService` &lt;=&gt; r.`InternetService`) OR NOT (s.`OnlineSecurity` &lt;=&gt; r.`OnlineSecurity`) OR NOT (s.`OnlineBackup` &lt;=&gt; r.`OnlineBackup`) OR NOT (s.`DeviceProtection` &lt;=&gt; r.`DeviceProtection`) OR NOT (s.`TechSupport` &lt;=&gt; r.`TechSupport`) OR NOT (s.`StreamingTV` &lt;=&gt; r.`StreamingTV`) OR NOT (s.`StreamingMovies` &lt;=&gt; r.`StreamingMovies`) OR NOT (s.`Contract` &lt;=&gt; r.`Contract`) OR NOT (s.`PaperlessBilling` &lt;=&gt; r.`PaperlessBilling`) OR NOT (s.`PaymentMethod` &lt;=&gt; r.`PaymentMethod`) OR NOT (s.`Churn` &lt;=&gt; r.`Churn`) OR NOT (s.`fecha_carga` &lt;=&gt; r.`fecha_carga`)) AS atributos_originales_alterados\n&quot;)) {&#10; rs.next();&#10; int errores = 0;&#10; long raw_filas = rs.getLong(&quot;raw_filas&quot;); System.out.println(&quot;raw_filas=&quot; + raw_filas + &quot; (esperado 7043)&quot;); if (raw_filas != 7043L) errores++;&#10; long raw_ids = rs.getLong(&quot;raw_ids&quot;); System.out.println(&quot;raw_ids=&quot; + raw_ids + &quot; (esperado 7043)&quot;); if (raw_ids != 7043L) errores++;&#10; long raw_nulos = rs.getLong(&quot;raw_nulos&quot;); System.out.println(&quot;raw_nulos=&quot; + raw_nulos + &quot; (esperado 0)&quot;); if (raw_nulos != 0L) errores++;&#10; long raw_blancos = rs.getLong(&quot;raw_blancos&quot;); System.out.println(&quot;raw_blancos=&quot; + raw_blancos + &quot; (esperado 11)&quot;); if (raw_blancos != 11L) errores++;&#10; long stg_filas = rs.getLong(&quot;stg_filas&quot;); System.out.println(&quot;stg_filas=&quot; + stg_filas + &quot; (esperado 7043)&quot;); if (stg_filas != 7043L) errores++;&#10; long stg_ids = rs.getLong(&quot;stg_ids&quot;); System.out.println(&quot;stg_ids=&quot; + stg_ids + &quot; (esperado 7043)&quot;); if (stg_ids != 7043L) errores++;&#10; long rechazos = rs.getLong(&quot;rechazos&quot;); System.out.println(&quot;rechazos=&quot; + rechazos + &quot; (esperado 0)&quot;); if (rechazos != 0L) errores++;&#10; long imputaciones = rs.getLong(&quot;imputaciones&quot;); System.out.println(&quot;imputaciones=&quot; + imputaciones + &quot; (esperado 11)&quot;); if (imputaciones != 11L) errores++;&#10; long imputaciones_correctas = rs.getLong(&quot;imputaciones_correctas&quot;); System.out.println(&quot;imputaciones_correctas=&quot; + imputaciones_correctas + &quot; (esperado 11)&quot;); if (imputaciones_correctas != 11L) errores++;&#10; long ids_sin_staging = rs.getLong(&quot;ids_sin_staging&quot;); System.out.println(&quot;ids_sin_staging=&quot; + ids_sin_staging + &quot; (esperado 0)&quot;); if (ids_sin_staging != 0L) errores++;&#10; long ids_sin_raw = rs.getLong(&quot;ids_sin_raw&quot;); System.out.println(&quot;ids_sin_raw=&quot; + ids_sin_raw + &quot; (esperado 0)&quot;); if (ids_sin_raw != 0L) errores++;&#10; long originales_alterados = rs.getLong(&quot;originales_alterados&quot;); System.out.println(&quot;originales_alterados=&quot; + originales_alterados + &quot; (esperado 0)&quot;); if (originales_alterados != 0L) errores++;&#10; long importes_invalidos = rs.getLong(&quot;importes_invalidos&quot;); System.out.println(&quot;importes_invalidos=&quot; + importes_invalidos + &quot; (esperado 0)&quot;); if (importes_invalidos != 0L) errores++;&#10; long valores_transformados_incorrectos = rs.getLong(&quot;valores_transformados_incorrectos&quot;); System.out.println(&quot;valores_transformados_incorrectos=&quot; + valores_transformados_incorrectos + &quot; (esperado 0)&quot;); if (valores_transformados_incorrectos != 0L) errores++;&#10; long atributos_originales_alterados = rs.getLong(&quot;atributos_originales_alterados&quot;); System.out.println(&quot;atributos_originales_alterados=&quot; + atributos_originales_alterados + &quot; (esperado 0)&quot;); if (atributos_originales_alterados != 0L) errores++;&#10; if (errores != 0) throw new RuntimeException(&quot;Validacion staging fallida: &quot; + errores + &quot; controles. Revisar los conteos; no se modifico raw.&quot;);&#10; System.out.println(&quot;STAGING VALIDADO: 7043 clientes, 11 imputaciones, raw intacto respecto a los controles definidos.&quot;);&#10;}&#10;&#10;try (java.sql.Connection modelCx = java.sql.DriverManager.getConnection(telcoUrl, telcoProps);&#10; java.sql.Statement modelSt = modelCx.createStatement()) {&#10; modelSt.execute(&quot;CREATE TABLE IF NOT EXISTS dim_customer_telco_g2 (\n customer_key BIGINT NOT NULL AUTO_INCREMENT,\n `customer_id` VARCHAR(20) NOT NULL,\n `gender` VARCHAR(10) NULL,\n `senior_citizen` VARCHAR(3) NULL,\n `partner` VARCHAR(3) NULL,\n `dependents` VARCHAR(3) NULL,\n `load_ts` DATETIME NULL,\n `load_source` VARCHAR(100) NULL,\n PRIMARY KEY (customer_key),\n SHARD KEY (customer_key),\n SORT KEY ()\n) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin&quot;);&#10; modelSt.execute(&quot;CREATE TABLE IF NOT EXISTS dim_contract_telco_g2 (\n contract_key BIGINT NOT NULL AUTO_INCREMENT,\n `contract_type` VARCHAR(20) NOT NULL,\n `paperless_billing` VARCHAR(3) NULL,\n `payment_method` VARCHAR(40) NULL,\n `load_ts` DATETIME NULL,\n `load_source` VARCHAR(100) NULL,\n PRIMARY KEY (contract_key),\n SHARD KEY (contract_key),\n SORT KEY ()\n) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin&quot;);&#10; modelSt.execute(&quot;CREATE TABLE IF NOT EXISTS dim_service_telco_g2 (\n service_key BIGINT NOT NULL AUTO_INCREMENT,\n `phone_service` VARCHAR(3) NULL,\n `multiple_lines` VARCHAR(30) NULL,\n `internet_service` VARCHAR(20) NULL,\n `online_security` VARCHAR(30) NULL,\n `online_backup` VARCHAR(30) NULL,\n `device_protection` VARCHAR(30) NULL,\n `tech_support` VARCHAR(30) NULL,\n `streaming_tv` VARCHAR(30) NULL,\n `streaming_movies` VARCHAR(30) NULL,\n `service_level` VARCHAR(30) NULL,\n `load_ts` DATETIME NULL,\n `load_source` VARCHAR(100) NULL,\n PRIMARY KEY (service_key),\n SHARD KEY (service_key),\n SORT KEY ()\n) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin&quot;);&#10; modelSt.execute(&quot;CREATE TABLE IF NOT EXISTS fact_contracts_telco_g2 (\n `customer_key` BIGINT NOT NULL,\n `contract_key` BIGINT NOT NULL,\n `service_key` BIGINT NOT NULL,\n `tenure_months` INT NOT NULL,\n `tenure_group` VARCHAR(10) NOT NULL,\n `monthly_charges` DECIMAL(8,2) NOT NULL,\n `total_charges` DECIMAL(10,2) NOT NULL,\n `churn_flag` INT NOT NULL,\n `total_charges_imputed` INT NOT NULL,\n `imputation_reason` VARCHAR(64) NULL,\n `source_load_id` VARCHAR(36) NOT NULL,\n `load_ts` DATETIME NULL,\n `load_source` VARCHAR(100) NULL,\n PRIMARY KEY (customer_key),\n SHARD KEY (customer_key),\n SORT KEY ()\n) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin&quot;);&#10; try (java.sql.ResultSet auditSchema = modelSt.executeQuery(&quot;SELECT COUNT(*) FROM information_schema.columns WHERE table_schema = DATABASE() AND table_name IN ('dim_customer_telco_g2','dim_contract_telco_g2','dim_service_telco_g2','fact_contracts_telco_g2') AND column_name = 'load_ts' AND data_type = 'datetime' AND column_default IS NULL AND LOWER(COALESCE(extra, '')) NOT LIKE '%on update%'&quot;)) { auditSchema.next(); if (auditSchema.getInt(1) != 4) throw new RuntimeException(&quot;Prepare load_ts DATETIME en los cuatro destinos antes de cargar en hora de Ecuador.&quot;); }&#10; try(java.sql.ResultSet rs=modelSt.executeQuery(&quot;SELECT (SELECT COUNT(*) FROM dim_customer_telco_g2) + (SELECT COUNT(*) FROM dim_contract_telco_g2) + (SELECT COUNT(*) FROM dim_service_telco_g2) + (SELECT COUNT(*) FROM fact_contracts_telco_g2)&quot;)){rs.next();if(rs.getLong(1)!=0)throw new RuntimeException(&quot;El modelo ya tiene datos. Carga inicial bloqueada para evitar duplicados. No se borro nada.&quot;);}&#10;}&#10;System.out.println(&quot;MODELO: staging validado y cuatro destinos vacios. Inicia carga dimensional.&quot;);&#10;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
