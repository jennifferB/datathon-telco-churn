    <elementParameter field="CHECK" name="END_OF_FLOW" value="true" show="false"/>
    <elementParameter field="TEXT" name="HELP" value="org.talend.help.tJava" show="false"/>
    <elementParameter field="DIRECTORY" name="IREPORT_PATH" value="" show="false"/>
    <elementParameter field="DIRECTORY" name="JAVA_LIBRARY_PATH" value="D:\Talent\studio\configuration\lib\java" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="if (!((&quot;telco_g2&quot;.equals(context.singlestore_database) &amp;&amp; &quot;3333&quot;.equals(context.singlestore_port)) || (&quot;DSADEV&quot;.equals(context.singlestore_database) &amp;&amp; &quot;3306&quot;.equals(context.singlestore_port) &amp;&amp; &quot;209.50.245.36&quot;.equals(context.singlestore_host))))&#10; throw new RuntimeException(&quot;Seleccione Cloud (telco_g2:3333) o PRUEBAS (DSADEV:3306 en el servidor de pruebas).&quot;);&#10;if (context.singlestore_password == null || context.singlestore_password.isEmpty())&#10; throw new RuntimeException(&quot;Ingrese la contraseña al ejecutar, sin guardarla en Git.&quot;);&#10;Class.forName(&quot;com.mysql.cj.jdbc.Driver&quot;);&#10;java.util.Properties telcoProps = new java.util.Properties();&#10;telcoProps.setProperty(&quot;user&quot;, context.singlestore_user);&#10;telcoProps.setProperty(&quot;password&quot;, context.singlestore_password);&#10;telcoProps.setProperty(&quot;sslMode&quot;, ((&quot;DSADEV&quot;.equals(context.singlestore_database) &amp;&amp; &quot;3306&quot;.equals(context.singlestore_port) &amp;&amp; &quot;209.50.245.36&quot;.equals(context.singlestore_host)) ? &quot;PREFERRED&quot; : &quot;REQUIRED&quot;));&#10;telcoProps.setProperty(&quot;connectTimeout&quot;, &quot;10000&quot;);&#10;String telcoUrl = &quot;jdbc:mysql://&quot; + context.singlestore_host.trim() + &quot;:&quot; + context.singlestore_port + &quot;/&quot; + context.singlestore_database;&#10;&#10;try(java.sql.Connection cx=java.sql.DriverManager.getConnection(telcoUrl,telcoProps); java.sql.Statement st=cx.createStatement(); java.sql.ResultSet rs=st.executeQuery(&quot;SELECT\n (SELECT COUNT(*) FROM raw_telco_g2) AS raw_filas,\n (SELECT COUNT(*) FROM raw_telco_g2 WHERE TotalCharges IS NOT NULL AND TRIM(TotalCharges)='') AS raw_blancos,\n (SELECT COUNT(*) FROM stg_telco_g2) AS staging_filas,\n (SELECT COUNT(*) FROM dim_customer_telco_g2) AS clientes,\n (SELECT COUNT(DISTINCT customer_id) FROM dim_customer_telco_g2) AS clientes_distintos,\n (SELECT COUNT(*) FROM dim_contract_telco_g2) AS contratos,\n (SELECT COUNT(*) FROM dim_service_telco_g2) AS servicios,\n (SELECT COUNT(*) FROM fact_contracts_telco_g2) AS hechos,\n (SELECT COUNT(*) FROM fact_contracts_telco_g2 WHERE churn_flag=1) AS clientes_churn,\n (SELECT COUNT(*) FROM fact_contracts_telco_g2 WHERE total_charges_imputed=1) AS imputaciones,\n (SELECT COUNT(*) FROM fact_contracts_telco_g2 f\n LEFT JOIN dim_customer_telco_g2 c ON f.customer_key=c.customer_key\n LEFT JOIN dim_contract_telco_g2 ct ON f.contract_key=ct.contract_key\n LEFT JOIN dim_service_telco_g2 sv ON f.service_key=sv.service_key\n WHERE c.customer_key IS NULL OR ct.contract_key IS NULL OR sv.service_key IS NULL) AS hechos_huerfanos,\n (SELECT COUNT(*) FROM stg_telco_g2 s\n LEFT JOIN dim_customer_telco_g2 c ON s.customerID=c.customer_id\n LEFT JOIN fact_contracts_telco_g2 f ON f.customer_key=c.customer_key\n WHERE f.customer_key IS NULL) AS clientes_sin_hecho,\n (SELECT COUNT(*) FROM fact_contracts_telco_g2 f\nJOIN dim_customer_telco_g2 c ON f.customer_key=c.customer_key\nJOIN dim_contract_telco_g2 ct ON f.contract_key=ct.contract_key\nJOIN dim_service_telco_g2 sv ON f.service_key=sv.service_key\nJOIN stg_telco_g2 s ON c.customer_id=s.customerID) AS clientes_reconciliados,\n (SELECT COUNT(*) FROM fact_contracts_telco_g2 f\nJOIN dim_customer_telco_g2 c ON f.customer_key=c.customer_key\nJOIN dim_contract_telco_g2 ct ON f.contract_key=ct.contract_key\nJOIN dim_service_telco_g2 sv ON f.service_key=sv.service_key\nJOIN stg_telco_g2 s ON c.customer_id=s.customerID WHERE NOT (f.monthly_charges &lt;=&gt; s.MonthlyCharges) OR NOT (f.total_charges &lt;=&gt; s.TotalCharges) OR NOT (f.tenure_months &lt;=&gt; s.tenure) OR NOT (f.churn_flag &lt;=&gt; CASE WHEN s.Churn = 'Yes' THEN 1 ELSE 0 END) OR NOT (f.tenure_group &lt;=&gt; CASE WHEN s.tenure &lt;= 12 THEN '0-12m' WHEN s.tenure &lt;= 24 THEN '13-24m' WHEN s.tenure &lt;= 48 THEN '25-48m' ELSE '&gt;48m' END) OR NOT (f.total_charges_imputed &lt;=&gt; s.total_charges_imputed) OR NOT (f.imputation_reason &lt;=&gt; s.imputation_reason) OR NOT (f.source_load_id &lt;=&gt; s.load_id) OR NOT (c.gender &lt;=&gt; s.gender) OR NOT (c.senior_citizen &lt;=&gt; CASE WHEN s.SeniorCitizen = 1 THEN 'Yes' ELSE 'No' END) OR NOT (c.partner &lt;=&gt; s.Partner) OR NOT (c.dependents &lt;=&gt; s.Dependents) OR NOT (ct.contract_type &lt;=&gt; s.Contract) OR NOT (ct.paperless_billing &lt;=&gt; s.PaperlessBilling) OR NOT (ct.payment_method &lt;=&gt; s.PaymentMethod) OR NOT (sv.phone_service &lt;=&gt; s.PhoneService) OR NOT (sv.multiple_lines &lt;=&gt; s.MultipleLines) OR NOT (sv.internet_service &lt;=&gt; s.InternetService) OR NOT (sv.online_security &lt;=&gt; s.OnlineSecurity) OR NOT (sv.online_backup &lt;=&gt; s.OnlineBackup) OR NOT (sv.device_protection &lt;=&gt; s.DeviceProtection) OR NOT (sv.tech_support &lt;=&gt; s.TechSupport) OR NOT (sv.streaming_tv &lt;=&gt; s.StreamingTV) OR NOT (sv.streaming_movies &lt;=&gt; s.StreamingMovies) OR NOT (sv.service_level &lt;=&gt; CASE WHEN s.InternetService = 'No' THEN 'Sin Internet' WHEN s.OnlineSecurity = 'Yes' OR s.TechSupport = 'Yes' THEN 'Protegido' ELSE 'Basico' END)) AS diferencias_modelo,\n (SELECT COUNT(*) FROM fact_contracts_telco_g2 WHERE churn_flag IS NULL OR churn_flag NOT IN (0,1)) AS churn_invalido\n&quot;)) {&#10;rs.next(); int errores=0;&#10;long raw_filas=rs.getLong(&quot;raw_filas&quot;);System.out.println(&quot;raw_filas=&quot;+raw_filas+&quot; (esperado 7043)&quot;);if(raw_filas!=7043L)errores++;&#10;long raw_blancos=rs.getLong(&quot;raw_blancos&quot;);System.out.println(&quot;raw_blancos=&quot;+raw_blancos+&quot; (esperado 11)&quot;);if(raw_blancos!=11L)errores++;&#10;long staging_filas=rs.getLong(&quot;staging_filas&quot;);System.out.println(&quot;staging_filas=&quot;+staging_filas+&quot; (esperado 7043)&quot;);if(staging_filas!=7043L)errores++;&#10;long clientes=rs.getLong(&quot;clientes&quot;);System.out.println(&quot;clientes=&quot;+clientes+&quot; (esperado 7043)&quot;);if(clientes!=7043L)errores++;&#10;long clientes_distintos=rs.getLong(&quot;clientes_distintos&quot;);System.out.println(&quot;clientes_distintos=&quot;+clientes_distintos+&quot; (esperado 7043)&quot;);if(clientes_distintos!=7043L)errores++;&#10;long contratos=rs.getLong(&quot;contratos&quot;);System.out.println(&quot;contratos=&quot;+contratos+&quot; (esperado 24)&quot;);if(contratos!=24L)errores++;&#10;long servicios=rs.getLong(&quot;servicios&quot;);System.out.println(&quot;servicios=&quot;+servicios+&quot; (esperado 322)&quot;);if(servicios!=322L)errores++;&#10;long hechos=rs.getLong(&quot;hechos&quot;);System.out.println(&quot;hechos=&quot;+hechos+&quot; (esperado 7043)&quot;);if(hechos!=7043L)errores++;&#10;long clientes_churn=rs.getLong(&quot;clientes_churn&quot;);System.out.println(&quot;clientes_churn=&quot;+clientes_churn+&quot; (esperado 1869)&quot;);if(clientes_churn!=1869L)errores++;&#10;long imputaciones=rs.getLong(&quot;imputaciones&quot;);System.out.println(&quot;imputaciones=&quot;+imputaciones+&quot; (esperado 11)&quot;);if(imputaciones!=11L)errores++;&#10;long hechos_huerfanos=rs.getLong(&quot;hechos_huerfanos&quot;);System.out.println(&quot;hechos_huerfanos=&quot;+hechos_huerfanos+&quot; (esperado 0)&quot;);if(hechos_huerfanos!=0L)errores++;&#10;long clientes_sin_hecho=rs.getLong(&quot;clientes_sin_hecho&quot;);System.out.println(&quot;clientes_sin_hecho=&quot;+clientes_sin_hecho+&quot; (esperado 0)&quot;);if(clientes_sin_hecho!=0L)errores++;&#10;long clientes_reconciliados=rs.getLong(&quot;clientes_reconciliados&quot;);System.out.println(&quot;clientes_reconciliados=&quot;+clientes_reconciliados+&quot; (esperado 7043)&quot;);if(clientes_reconciliados!=7043L)errores++;&#10;long diferencias_modelo=rs.getLong(&quot;diferencias_modelo&quot;);System.out.println(&quot;diferencias_modelo=&quot;+diferencias_modelo+&quot; (esperado 0)&quot;);if(diferencias_modelo!=0L)errores++;&#10;long churn_invalido=rs.getLong(&quot;churn_invalido&quot;);System.out.println(&quot;churn_invalido=&quot;+churn_invalido+&quot; (esperado 0)&quot;);if(churn_invalido!=0L)errores++;&#10;if(errores!=0)throw new RuntimeException(&quot;MODELO DIMENSIONAL VALIDADO: &quot; + errores + &quot; controles fallidos.&quot;);&#10;System.out.println(&quot;MODELO DIMENSIONAL VALIDADO&quot;);}&#10;"/>
