    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMysqlInput_4" show="false"/>
    <elementParameter field="TEXT" name="COMPONENT_NAME" value="tMysqlInput" show="false"/>
    <elementParameter field="TEXT" name="VERSION" value="0.102 (ALPHA)" show="false"/>
    <elementParameter field="TEXT" name="FAMILY" value="Databases/DB Specifics/MySQL" show="false"/>
