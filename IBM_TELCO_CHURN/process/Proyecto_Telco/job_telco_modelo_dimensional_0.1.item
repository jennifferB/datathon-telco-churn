    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="if (!((&quot;telco_g2&quot;.equals(context.singlestore_database) &amp;&amp; &quot;3333&quot;.equals(context.singlestore_port)) || (&quot;DSADEV&quot;.equals(context.singlestore_database) &amp;&amp; &quot;3306&quot;.equals(context.singlestore_port) &amp;&amp; &quot;209.50.245.36&quot;.equals(context.singlestore_host))))&#10; throw new RuntimeException(&quot;Seleccione Cloud (telco_g2:3333) o PRUEBAS (DSADEV:3306 en el servidor de pruebas).&quot;);&#10;if (context.singlestore_password == null || context.singlestore_password.isEmpty())&#10; throw new RuntimeException(&quot;Ingrese la contraseña al ejecutar, sin guardarla en Git.&quot;);&#10;Class.forName(&quot;com.mysql.cj.jdbc.Driver&quot;);&#10;java.util.Properties telcoProps = new java.util.Properties();&#10;telcoProps.setProperty(&quot;user&quot;, context.singlestore_user);&#10;telcoProps.setProperty(&quot;password&quot;, context.singlestore_password);&#10;telcoProps.setProperty(&quot;sslMode&quot;, ((&quot;DSADEV&quot;.equals(context.singlestore_database) &amp;&amp; &quot;3306&quot;.equals(context.singlestore_port) &amp;&amp; &quot;209.50.245.36&quot;.equals(context.singlestore_host)) ? &quot;PREFERRED&quot; : &quot;REQUIRED&quot;));&#10;telcoProps.setProperty(&quot;connectTimeout&quot;, &quot;10000&quot;);&#10;String telcoUrl = &quot;jdbc:mysql://&quot; + context.singlestore_host.trim() + &quot;:&quot; + context.singlestore_port + &quot;/&quot; + context.singlestore_database;&#10;&#10;try(java.sql.Connection cx=java.sql.DriverManager.getConnection(telcoUrl,telcoProps); java.sql.Statement st=cx.createStatement(); java.sql.ResultSet rs=st.executeQuery(&quot;SELECT\n (SELECT COUNT(*) FROM dim_customer_telco_g2) AS clientes,\n (SELECT COUNT(DISTINCT customer_id) FROM dim_customer_telco_g2) AS ids_unicos,\n (SELECT COUNT(*) FROM dim_contract_telco_g2) AS contratos,\n (SELECT COUNT(*) FROM dim_service_telco_g2) AS servicios,\n (SELECT COUNT(*) FROM (SELECT s.customerID\nFROM stg_telco_g2 s\nJOIN dim_customer_telco_g2 c ON s.customerID = c.customer_id\nJOIN dim_contract_telco_g2 ct ON s.Contract = ct.contract_type AND s.PaperlessBilling = ct.paperless_billing AND s.PaymentMethod = ct.payment_method\nJOIN dim_service_telco_g2 sv ON s.PhoneService = sv.phone_service AND s.MultipleLines = sv.multiple_lines AND s.InternetService = sv.internet_service AND s.OnlineSecurity = sv.online_security AND s.OnlineBackup = sv.online_backup AND s.DeviceProtection = sv.device_protection AND s.TechSupport = sv.tech_support AND s.StreamingTV = sv.streaming_tv AND s.StreamingMovies = sv.streaming_movies\n GROUP BY s.customerID HAVING COUNT(*) = 1) x) AS clientes_con_join_unico\n&quot;)) {&#10;rs.next(); int errores=0;&#10;long clientes=rs.getLong(&quot;clientes&quot;);System.out.println(&quot;clientes=&quot;+clientes+&quot; (esperado 7043)&quot;);if(clientes!=7043L)errores++;&#10;long ids_unicos=rs.getLong(&quot;ids_unicos&quot;);System.out.println(&quot;ids_unicos=&quot;+ids_unicos+&quot; (esperado 7043)&quot;);if(ids_unicos!=7043L)errores++;&#10;long contratos=rs.getLong(&quot;contratos&quot;);System.out.println(&quot;contratos=&quot;+contratos+&quot; (esperado 24)&quot;);if(contratos!=24L)errores++;&#10;long servicios=rs.getLong(&quot;servicios&quot;);System.out.println(&quot;servicios=&quot;+servicios+&quot; (esperado 322)&quot;);if(servicios!=322L)errores++;&#10;long clientes_con_join_unico=rs.getLong(&quot;clientes_con_join_unico&quot;);System.out.println(&quot;clientes_con_join_unico=&quot;+clientes_con_join_unico+&quot; (esperado 7043)&quot;);if(clientes_con_join_unico!=7043L)errores++;&#10;if(errores!=0)throw new RuntimeException(&quot;DIMENSIONES VALIDADAS: &quot; + errores + &quot; controles fallidos.&quot;);&#10;System.out.println(&quot;DIMENSIONES VALIDADAS&quot;);}&#10;"/>
