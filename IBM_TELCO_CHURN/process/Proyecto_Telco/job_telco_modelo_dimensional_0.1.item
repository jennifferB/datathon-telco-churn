    <elementParameter field="DBTABLE" name="TABLE" value="&quot;stg_telco_g2&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT c.customer_key, ct.contract_key, sv.service_key, s.tenure AS tenure_months, CASE WHEN s.tenure &lt;= 12 THEN '0-12m' WHEN s.tenure &lt;= 24 THEN '13-24m' WHEN s.tenure &lt;= 48 THEN '25-48m' ELSE '&gt;48m' END AS tenure_group, s.MonthlyCharges AS monthly_charges, s.TotalCharges AS total_charges, CASE WHEN s.Churn = 'Yes' THEN 1 WHEN s.Churn = 'No' THEN 0 ELSE NULL END AS churn_flag, s.total_charges_imputed, s.imputation_reason, s.load_id AS source_load_id, CAST(DATE_SUB(UTC_TIMESTAMP(), INTERVAL 5 HOUR) AS CHAR) AS load_ts, '&quot; + context.load_source.replace(&quot;'&quot;, &quot;''&quot;) + &quot;' AS load_source\nFROM stg_telco_g2 s\nJOIN dim_customer_telco_g2 c ON s.customerID = c.customer_id\nJOIN dim_contract_telco_g2 ct ON s.Contract = ct.contract_type AND s.PaperlessBilling = ct.paperless_billing AND s.PaymentMethod = ct.payment_method\nJOIN dim_service_telco_g2 sv ON s.PhoneService = sv.phone_service AND s.MultipleLines = sv.multiple_lines AND s.InternetService = sv.internet_service AND s.OnlineSecurity = sv.online_security AND s.OnlineBackup = sv.online_backup AND s.DeviceProtection = sv.device_protection AND s.TechSupport = sv.tech_support AND s.StreamingTV = sv.streaming_tv AND s.StreamingMovies = sv.streaming_movies&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
    <elementParameter field="MAPPING_TYPE" name="MAPPING" value="mysql_id" show="false"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="&quot;noDatetimeStringSync=true&amp;sslMode=&quot; + ((&quot;DSADEV&quot;.equals(context.singlestore_database) &amp;&amp; &quot;3306&quot;.equals(context.singlestore_port) &amp;&amp; &quot;209.50.245.36&quot;.equals(context.singlestore_host)) ? &quot;PREFERRED&quot; : &quot;REQUIRED&quot;) + &quot;&amp;connectTimeout=10000&amp;serverTimezone=UTC&quot;"/>
    <elementParameter field="ENCODING_TYPE" name="ENCODING" value="&quot;ISO-8859-15&quot;" show="false"/>
    <elementParameter field="TECHNICAL" name="ENCODING:ENCODING_TYPE" value="ISO-8859-15"/>
