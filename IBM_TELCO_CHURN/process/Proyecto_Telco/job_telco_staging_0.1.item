  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="120" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="TEXT" name="COMPONENT_NAME" value="tJava" show="false"/>
    <elementParameter field="TEXT" name="VERSION" value="0.101 (ALPHA)" show="false"/>
    <elementParameter field="TEXT" name="FAMILY" value="Custom_Code" show="false"/>
    <elementParameter field="CHECK" name="START" value="true" show="false"/>
    <elementParameter field="CHECK" name="STARTABLE" value="true" show="false"/>
    <elementParameter field="CHECK" name="SUBTREE_START" value="true" show="false"/>
    <elementParameter field="CHECK" name="END_OF_FLOW" value="true" show="false"/>
    <elementParameter field="TEXT" name="HELP" value="org.talend.help.tJava" show="false"/>
    <elementParameter field="DIRECTORY" name="IREPORT_PATH" value="" show="false"/>
    <elementParameter field="DIRECTORY" name="JAVA_LIBRARY_PATH" value="D:\Talent\studio\configuration\lib\java" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="if (!((&quot;telco_g2&quot;.equals(context.singlestore_database) &amp;&amp; &quot;3333&quot;.equals(context.singlestore_port)) || (&quot;DSADEV&quot;.equals(context.singlestore_database) &amp;&amp; &quot;3306&quot;.equals(context.singlestore_port) &amp;&amp; &quot;209.50.245.36&quot;.equals(context.singlestore_host))))&#10; throw new RuntimeException(&quot;Seleccione Cloud (telco_g2:3333) o PRUEBAS (DSADEV:3306 en el servidor de pruebas).&quot;);&#10;if (context.singlestore_password == null || context.singlestore_password.isEmpty())&#10; throw new RuntimeException(&quot;Ingrese la contraseña al ejecutar, sin guardarla en Git.&quot;);&#10;Class.forName(&quot;com.mysql.cj.jdbc.Driver&quot;);&#10;java.util.Properties telcoProps = new java.util.Properties();&#10;telcoProps.setProperty(&quot;user&quot;, context.singlestore_user);&#10;telcoProps.setProperty(&quot;password&quot;, context.singlestore_password);&#10;telcoProps.setProperty(&quot;sslMode&quot;, ((&quot;DSADEV&quot;.equals(context.singlestore_database) &amp;&amp; &quot;3306&quot;.equals(context.singlestore_port) &amp;&amp; &quot;209.50.245.36&quot;.equals(context.singlestore_host)) ? &quot;PREFERRED&quot; : &quot;REQUIRED&quot;));&#10;telcoProps.setProperty(&quot;connectTimeout&quot;, &quot;10000&quot;);&#10;String telcoUrl = &quot;jdbc:mysql://&quot; + context.singlestore_host.trim() + &quot;:&quot; + context.singlestore_port + &quot;/&quot; + context.singlestore_database;&#10;&#10;try (java.sql.Connection cx = java.sql.DriverManager.getConnection(telcoUrl, telcoProps);&#10;     java.sql.Statement st = cx.createStatement()) {&#10; try (java.sql.ResultSet rs = st.executeQuery(&quot;SELECT COUNT(*), COUNT(DISTINCT customerID) FROM raw_telco_g2&quot;)) {&#10;  rs.next(); long filas = rs.getLong(1); long ids = rs.getLong(2);&#10;  if (filas != 7043 || ids != filas) throw new RuntimeException(&quot;Raw debe tener 7043 filas e IDs distintos. Encontradas: &quot; + filas + &quot;, &quot; + ids);&#10; }&#10; st.execute(&quot;CREATE TABLE IF NOT EXISTS stg_telco_g2 (\n `customerID` VARCHAR(20) NOT NULL,\n `gender` VARCHAR(10) NULL,\n `SeniorCitizen` INT NULL,\n `Partner` VARCHAR(3) NULL,\n `Dependents` VARCHAR(3) NULL,\n `tenure` INT NULL,\n `PhoneService` VARCHAR(3) NULL,\n `MultipleLines` VARCHAR(30) NULL,\n `InternetService` VARCHAR(20) NULL,\n `OnlineSecurity` VARCHAR(30) NULL,\n `OnlineBackup` VARCHAR(30) NULL,\n `DeviceProtection` VARCHAR(30) NULL,\n `TechSupport` VARCHAR(30) NULL,\n `StreamingTV` VARCHAR(30) NULL,\n `StreamingMovies` VARCHAR(30) NULL,\n `Contract` VARCHAR(20) NULL,\n `PaperlessBilling` VARCHAR(3) NULL,\n `PaymentMethod` VARCHAR(40) NULL,\n `MonthlyCharges` DECIMAL(8,2) NOT NULL,\n `TotalCharges` DECIMAL(10,2) NOT NULL,\n `Churn` VARCHAR(3) NULL,\n `fecha_carga` DATETIME NULL,\n `monthly_charges_raw` VARCHAR(20) NULL,\n `total_charges_raw` VARCHAR(20) NULL,\n `total_charges_imputed` INT NOT NULL,\n `imputation_reason` VARCHAR(64) NULL,\n `load_id` VARCHAR(36) NOT NULL,\n `fecha_staging` DATETIME NOT NULL,\n PRIMARY KEY (customerID),\n SHARD KEY (customerID),\n SORT KEY ()\n) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin&quot;);&#10; st.execute(&quot;CREATE TABLE IF NOT EXISTS rejects_telco_g2 (\n `customerID` VARCHAR(20) NULL,\n `gender` VARCHAR(10) NULL,\n `SeniorCitizen` INT NULL,\n `Partner` VARCHAR(3) NULL,\n `Dependents` VARCHAR(3) NULL,\n `tenure` INT NULL,\n `PhoneService` VARCHAR(3) NULL,\n `MultipleLines` VARCHAR(30) NULL,\n `InternetService` VARCHAR(20) NULL,\n `OnlineSecurity` VARCHAR(30) NULL,\n `OnlineBackup` VARCHAR(30) NULL,\n `DeviceProtection` VARCHAR(30) NULL,\n `TechSupport` VARCHAR(30) NULL,\n `StreamingTV` VARCHAR(30) NULL,\n `StreamingMovies` VARCHAR(30) NULL,\n `Contract` VARCHAR(20) NULL,\n `PaperlessBilling` VARCHAR(3) NULL,\n `PaymentMethod` VARCHAR(40) NULL,\n `MonthlyCharges` VARCHAR(20) NULL,\n `TotalCharges` VARCHAR(20) NULL,\n `Churn` VARCHAR(3) NULL,\n `fecha_carga` DATETIME NULL,\n `reject_reason` VARCHAR(1024) NOT NULL,\n `load_id` VARCHAR(36) NOT NULL,\n `fecha_rechazo` DATETIME NOT NULL,\n SHARD KEY (),\n SORT KEY ()\n) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin&quot;);&#10; try (java.sql.ResultSet rs = st.executeQuery(&quot;SELECT (SELECT COUNT(*) FROM stg_telco_g2) + (SELECT COUNT(*) FROM rejects_telco_g2)&quot;)) {&#10;  rs.next(); if (rs.getLong(1) != 0) throw new RuntimeException(&quot;Staging o rechazos ya contienen datos. Carga inicial bloqueada para evitar duplicados. No se borro nada.&quot;);&#10; }&#10;}&#10;globalMap.put(&quot;telco_load_id&quot;, java.util.UUID.randomUUID().toString());&#10;globalMap.put(&quot;telco_load_time&quot;, new java.util.Date());&#10;System.out.println(&quot;Prevalidacion OK: raw con 7043 IDs unicos; staging y rechazos vacios.&quot;);&#10;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="Validar raw y preparar destinos"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>
