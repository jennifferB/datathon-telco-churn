    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties/>
      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="id_valido" expression="row_raw.customerID != null &amp;&amp; !row_raw.customerID.trim().isEmpty() &amp;&amp; row_raw.customerID.length() &lt;= 20" type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="tenure_valido" expression="row_raw.tenure != null &amp;&amp; row_raw.tenure &gt;= 0 &amp;&amp; row_raw.tenure &lt;= 72" type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="monthly_text" expression="row_raw.MonthlyCharges == null ? null : row_raw.MonthlyCharges.trim()" type="id_String" nullable="true"/>
        <mapperTableEntries name="total_text" expression="row_raw.TotalCharges == null ? null : row_raw.TotalCharges.trim()" type="id_String" nullable="true"/>
        <mapperTableEntries name="monthly_formato" expression="Var.monthly_text != null &amp;&amp; Var.monthly_text.matches(&quot;[0-9]{1,3}([.][0-9]{1,2})?&quot;)" type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="monthly_num" expression="Var.monthly_formato ? new java.math.BigDecimal(Var.monthly_text).setScale(2) : null" type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="monthly_valido" expression="Var.monthly_formato &amp;&amp; Var.monthly_num.compareTo(new java.math.BigDecimal(&quot;18.00&quot;)) &gt;= 0 &amp;&amp; Var.monthly_num.compareTo(new java.math.BigDecimal(&quot;120.00&quot;)) &lt;= 0" type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="imputar" expression="Var.total_text != null &amp;&amp; Var.total_text.isEmpty() &amp;&amp; row_raw.tenure != null &amp;&amp; row_raw.tenure == 0" type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="total_formato" expression="Var.total_text != null &amp;&amp; Var.total_text.matches(&quot;[0-9]{1,8}([.][0-9]{1,2})?&quot;)" type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="total_valido" expression="Var.imputar || Var.total_formato" type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="total_num" expression="Var.imputar ? new java.math.BigDecimal(&quot;0.00&quot;) : (Var.total_formato ? new java.math.BigDecimal(Var.total_text).setScale(2) : null)" type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="dominios_validos" expression="(row_raw.SeniorCitizen != null &amp;&amp; (row_raw.SeniorCitizen == 0 || row_raw.SeniorCitizen == 1)) &amp;&amp; (java.util.Arrays.asList(&quot;Female&quot;, &quot;Male&quot;).contains(row_raw.gender)) &amp;&amp; (java.util.Arrays.asList(&quot;Yes&quot;, &quot;No&quot;).contains(row_raw.Partner)) &amp;&amp; (java.util.Arrays.asList(&quot;Yes&quot;, &quot;No&quot;).contains(row_raw.Dependents)) &amp;&amp; (java.util.Arrays.asList(&quot;Yes&quot;, &quot;No&quot;).contains(row_raw.PhoneService)) &amp;&amp; (java.util.Arrays.asList(&quot;Yes&quot;, &quot;No&quot;).contains(row_raw.PaperlessBilling)) &amp;&amp; (java.util.Arrays.asList(&quot;Yes&quot;, &quot;No&quot;).contains(row_raw.Churn)) &amp;&amp; (java.util.Arrays.asList(&quot;Yes&quot;, &quot;No&quot;, &quot;No phone service&quot;).contains(row_raw.MultipleLines)) &amp;&amp; (java.util.Arrays.asList(&quot;DSL&quot;, &quot;Fiber optic&quot;, &quot;No&quot;).contains(row_raw.InternetService)) &amp;&amp; (java.util.Arrays.asList(&quot;Month-to-month&quot;, &quot;One year&quot;, &quot;Two year&quot;).contains(row_raw.Contract)) &amp;&amp; (java.util.Arrays.asList(&quot;Electronic check&quot;, &quot;Mailed check&quot;, &quot;Bank transfer (automatic)&quot;, &quot;Credit card (automatic)&quot;).contains(row_raw.PaymentMethod)) &amp;&amp; (java.util.Arrays.asList(&quot;Yes&quot;, &quot;No&quot;, &quot;No internet service&quot;).contains(row_raw.OnlineSecurity)) &amp;&amp; (java.util.Arrays.asList(&quot;Yes&quot;, &quot;No&quot;, &quot;No internet service&quot;).contains(row_raw.OnlineBackup)) &amp;&amp; (java.util.Arrays.asList(&quot;Yes&quot;, &quot;No&quot;, &quot;No internet service&quot;).contains(row_raw.DeviceProtection)) &amp;&amp; (java.util.Arrays.asList(&quot;Yes&quot;, &quot;No&quot;, &quot;No internet service&quot;).contains(row_raw.TechSupport)) &amp;&amp; (java.util.Arrays.asList(&quot;Yes&quot;, &quot;No&quot;, &quot;No internet service&quot;).contains(row_raw.StreamingTV)) &amp;&amp; (java.util.Arrays.asList(&quot;Yes&quot;, &quot;No&quot;, &quot;No internet service&quot;).contains(row_raw.StreamingMovies))" type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="servicios_coherentes" expression="((&quot;No&quot;.equals(row_raw.PhoneService) &amp;&amp; &quot;No phone service&quot;.equals(row_raw.MultipleLines)) || (&quot;Yes&quot;.equals(row_raw.PhoneService) &amp;&amp; java.util.Arrays.asList(&quot;Yes&quot;,&quot;No&quot;).contains(row_raw.MultipleLines))) &amp;&amp; ((&quot;No&quot;.equals(row_raw.InternetService) &amp;&amp; &quot;No internet service&quot;.equals(row_raw.OnlineSecurity)) || (java.util.Arrays.asList(&quot;DSL&quot;,&quot;Fiber optic&quot;).contains(row_raw.InternetService) &amp;&amp; java.util.Arrays.asList(&quot;Yes&quot;,&quot;No&quot;).contains(row_raw.OnlineSecurity))) &amp;&amp; ((&quot;No&quot;.equals(row_raw.InternetService) &amp;&amp; &quot;No internet service&quot;.equals(row_raw.OnlineBackup)) || (java.util.Arrays.asList(&quot;DSL&quot;,&quot;Fiber optic&quot;).contains(row_raw.InternetService) &amp;&amp; java.util.Arrays.asList(&quot;Yes&quot;,&quot;No&quot;).contains(row_raw.OnlineBackup))) &amp;&amp; ((&quot;No&quot;.equals(row_raw.InternetService) &amp;&amp; &quot;No internet service&quot;.equals(row_raw.DeviceProtection)) || (java.util.Arrays.asList(&quot;DSL&quot;,&quot;Fiber optic&quot;).contains(row_raw.InternetService) &amp;&amp; java.util.Arrays.asList(&quot;Yes&quot;,&quot;No&quot;).contains(row_raw.DeviceProtection))) &amp;&amp; ((&quot;No&quot;.equals(row_raw.InternetService) &amp;&amp; &quot;No internet service&quot;.equals(row_raw.TechSupport)) || (java.util.Arrays.asList(&quot;DSL&quot;,&quot;Fiber optic&quot;).contains(row_raw.InternetService) &amp;&amp; java.util.Arrays.asList(&quot;Yes&quot;,&quot;No&quot;).contains(row_raw.TechSupport))) &amp;&amp; ((&quot;No&quot;.equals(row_raw.InternetService) &amp;&amp; &quot;No internet service&quot;.equals(row_raw.StreamingTV)) || (java.util.Arrays.asList(&quot;DSL&quot;,&quot;Fiber optic&quot;).contains(row_raw.InternetService) &amp;&amp; java.util.Arrays.asList(&quot;Yes&quot;,&quot;No&quot;).contains(row_raw.StreamingTV))) &amp;&amp; ((&quot;No&quot;.equals(row_raw.InternetService) &amp;&amp; &quot;No internet service&quot;.equals(row_raw.StreamingMovies)) || (java.util.Arrays.asList(&quot;DSL&quot;,&quot;Fiber optic&quot;).contains(row_raw.InternetService) &amp;&amp; java.util.Arrays.asList(&quot;Yes&quot;,&quot;No&quot;).contains(row_raw.StreamingMovies)))" type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="fila_valida" expression="Var.id_valido &amp;&amp; Var.tenure_valido &amp;&amp; Var.monthly_valido &amp;&amp; Var.total_valido &amp;&amp; Var.dominios_validos &amp;&amp; Var.servicios_coherentes" type="id_Boolean" nullable="true"/>
        <mapperTableEntries name="motivo" expression="(Var.id_valido ? &quot;&quot; : &quot;DQ_ID_INVALIDO;&quot;) + (Var.tenure_valido ? &quot;&quot; : &quot;DQ_TENURE_RANGO;&quot;) + (Var.monthly_valido ? &quot;&quot; : &quot;DQ_MONTHLY_FORMATO_O_RANGO;&quot;) + (Var.total_valido ? &quot;&quot; : &quot;DQ_TOTAL_NULO_FORMATO_O_BLANCO_NO_IMPUTABLE;&quot;) + (Var.dominios_validos ? &quot;&quot; : &quot;DQ_CATEGORIA_INVALIDA;&quot;) + (Var.servicios_coherentes ? &quot;&quot; : &quot;DQ_SERVICIOS_INCONSISTENTES;&quot;)" type="id_String" nullable="true"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="out_stg" expressionFilter="Var.fila_valida" activateExpressionFilter="true">
        <mapperTableEntries name="customerID" expression="row_raw.customerID" type="id_String"/>
        <mapperTableEntries name="gender" expression="row_raw.gender" type="id_String" nullable="true"/>
        <mapperTableEntries name="SeniorCitizen" expression="row_raw.SeniorCitizen" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="Partner" expression="row_raw.Partner" type="id_String" nullable="true"/>
        <mapperTableEntries name="Dependents" expression="row_raw.Dependents" type="id_String" nullable="true"/>
        <mapperTableEntries name="tenure" expression="row_raw.tenure" type="id_Integer" nullable="true"/>
        <mapperTableEntries name="PhoneService" expression="row_raw.PhoneService" type="id_String" nullable="true"/>
        <mapperTableEntries name="MultipleLines" expression="row_raw.MultipleLines" type="id_String" nullable="true"/>
        <mapperTableEntries name="InternetService" expression="row_raw.InternetService" type="id_String" nullable="true"/>
        <mapperTableEntries name="OnlineSecurity" expression="row_raw.OnlineSecurity" type="id_String" nullable="true"/>
